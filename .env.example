# ---- 基础 ----
ASSET_DIR=./frontend
PORT=8874
# 运行环境标识（可留空）
ENV=

# ---- 资源配置存储（SQLite）----
# 首页「资源配置管理」存储 MySQL / FTP / SSH / S3 / Redis 连接配置
SQLITE_PATH=./data/devops-console.db
# 配置中密码字段的加密密钥（AES-GCM，建议改为随机值；改动后历史密码将无法解密）
CONFIG_SECRET=devops-console-default-secret

# ---- 登录 / 鉴权 ----
LOGIN_USER=admin
LOGIN_PASSWORD=change-me
# 鉴权 Cookie 键名
TOKEN_KEY=devops-token
# JWT 签名密钥（务必改成随机值）
JWT_SECRET=
# JWT 过期时长（小时）
JWT_EXPIRE_HOURS=24
# 写 Cookie 的域（留空则按请求 Host 自动判断）
COOKIE_DOMAIN=

# ---- MySQL ----
# 单实例；库名用逗号分隔，页面按库名访问
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASES=

# ---- Redis ----
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=

# ---- S3 / 对象存储 ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- FTP ----
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PREFIX=

# ---- SSH 节点（JSON）----
# 示例: {"nodes":{"10.0.0.1":{"user":"root","password":"xxx","port":"22"}},"file_roots":["/data"]}
SSH_NODES=

# ---- Apollo（可选）----
APOLLO_BASE_URL=http://localhost:8080
APOLLO_LOGIN_USER=apollo
APOLLO_LOGIN_PASSWORD=
APOLLO_OPENAPI_TOKEN=

# ---- 可选：预置 API 静态 token 保护（JSON）----
# 示例: {"access_api_list":["/api/xxx"],"token":"secret"}
API_AUTH_TOKEN=
