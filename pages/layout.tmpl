<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="description" content="{[{ .description }]}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <title>{[{.title}]}</title>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <link type="text/css" rel="stylesheet" href="/assets/css/bootstrap3.4.min.css" />
    <link type="text/css" rel="stylesheet" href="/assets/css/my.css" />
    <link type="text/css" rel="stylesheet" href="/assets/css/jsoneditor9.8.css" />
    <link type="text/css" rel="stylesheet" href="/assets/css/editormd.preview.css" />
    <link type="text/css" rel="stylesheet" href="/assets/css/my.css" />

    <script src="/assets/js/jquery.js"></script>
    <script src="/assets/js/vue.global.js"></script>
    <script src="/assets/js/axios.min.js"></script>
    <script src="/assets/js/dayjs.min.js"></script>
    <script src="/assets/js/jsoneditor9.8.js"></script>
    <script src="/assets/js/bootstrap.min.js"></script>
    <script src="/assets/js/bootbox.min.js"></script>
    <script src="/assets/js/marked.min.js"></script>
    <script src="/assets/js/editormd.js"></script>
    <script src="/assets/js/filesize.min.js"></script>
    <script src="/assets/js/qrcode.min.js"></script>
    <script src="/assets/js/json-bigint-browser.min.js"></script>
    <script src="/assets/js/my.js"></script>
    <script type="text/javascript">
        // 服务端页面数据（PageData.Extension），html/template 自动 JSON 编码并转义
        window.PageData = {[{ .extension }]} || {}
        window.VueObject = null
        window.VueMount = "#app"
        window.Vm = null
        function mountVueObject(object, element) {
            if (Vue === undefined) {
                console.log("mountVueObject, Vue not defined");
                return;
            }
            var vm = Vue.createApp(object);
            vm.mount(element);
            return vm;
        }
        document.addEventListener("DOMContentLoaded", async () => {
            setTimeout(() => {
                window.Vm = mountVueObject(window.VueObject, window.VueMount)
            },500)
            
        }, false);
    </script>
</head>

<body style="padding: 20px 10% 0;">

    {[{ if .breadcrumbs }]}
    <ol class="breadcrumb">
        {[{ range .breadcrumbs }]}
        {[{ if .URL }]}
        <li><a href="{[{ .URL }]}">{[{ .Name }]}</a></li>
        {[{ else }]}
        <li class="active">{[{ .Name }]}</li>
        {[{ end }]}
        {[{ end }]}
    </ol>
    {[{ end }]}
    <div id="app"></div>
    {[{ yield }]}
    
</body>
</html>
