            scaleResource(item) {
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                const r = (this.currentResource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法 scale')
                    return
                }
                if (!this.isScaleSupported) {
                    bootbox.alert('当前资源不支持 scale')
                    return
                }
                // 获取当前副本数
                let currentReplicas = ''
                const spec = (item && item.spec) || {}
                if (spec.replicas != null) {
                    currentReplicas = String(spec.replicas)
                }
                bootbox.prompt({
                    title: 'Scale ' + r + ' ' + ns + '/' + name,
                    message: '<p>当前副本数：<strong>' + (currentReplicas || '未知') + '</strong></p><p>请输入新的副本数：</p>',
                    inputType: 'number',
                    value: currentReplicas,
                    callback: async (result) => {
                        if (result === null) {
                            return
                        }
                        const replicas = parseInt(result, 10)
                        if (isNaN(replicas) || replicas < 0) {
                            bootbox.alert('请输入有效的副本数（>= 0）')
                            return
                        }
                        try {
                            bootboxLoading('scale 中...')
                            const url = '/api/k3s/scale/' + encodeURIComponent(r)
                            const resp = await axios.post(url, null, {
                                params: {
                                    name: name,
                                    namespace: ns,
                                    replicas: replicas,
                                }
                            })
                            bootbox.hideAll()
                            if (!resp.data || resp.data.code !== 0) {
                                bootbox.alert('scale 失败：' + ((resp.data && resp.data.message) || '未知错误'))
                                return
                            }
                            const data = resp.data.data || {}
                            const prev = data.previousReplicas != null ? data.previousReplicas : '?'
                            const curr = data.currentReplicas != null ? data.currentReplicas : '?'
                            bootbox.alert('Scale 成功：' + prev + ' → ' + curr, async () => {
                                await this.fetchList()
                            })
                        } catch (e) {
                            bootbox.hideAll()
                            bootbox.alert('scale 失败：' + (e && e.message ? e.message : e))
                        }
                    }
                })
            },
            openUpdateResourceModal(item) {
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                const r = (this.currentResource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法更新资源')
                    return
                }
                if (!this.isResourceUpdateSupported) {
                    bootbox.alert('当前资源不支持更新资源配额')
                    return
                }
                const containers = this.getContainers(item)
                this.updateResTarget = { resource: r, name: name, namespace: ns }
                this.updateResContainers = containers.map((c, i) => ({
                    name: (c && c.name) ? c.name : ('#' + i),
                    resources: (c && c.resources) || {},
                }))
                // 默认选中第一个容器
                this.updateResSelectedContainer = this.updateResContainers.length ? this.updateResContainers[0].name : ''
                this.fillResourceFormFromContainer()
                this.updatingResource = false
                $('#k3sUpdateResourceModal').modal('show')
            },
            fillResourceFormFromContainer() {
                // 根据当前选中容器回填现有值，方便在原值上修改
                let target = null
                for (let i = 0; i < this.updateResContainers.length; i++) {
                    if (this.updateResContainers[i].name === this.updateResSelectedContainer) {
                        target = this.updateResContainers[i]
                        break
                    }
                }
                const res = (target && target.resources) || {}
                const req = res.requests || {}
                const lim = res.limits || {}
                this.updateResForm = {
                    request_cpu: req.cpu != null ? String(req.cpu) : '',
                    request_memory: req.memory != null ? String(req.memory) : '',
                    limit_cpu: lim.cpu != null ? String(lim.cpu) : '',
                    limit_memory: lim.memory != null ? String(lim.memory) : '',
                }
            },
            async submitUpdateResource() {
                if (this.updatingResource) {
                    return
                }
                const t = this.updateResTarget || {}
                const name = (t.name || '').trim()
                const ns = (t.namespace || '').trim()
                const r = (t.resource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法更新资源')
                    return
                }
                const containerName = (this.updateResSelectedContainer || '').trim()
                if (!containerName) {
                    bootbox.alert('未选择容器，无法更新资源')
                    return
                }
                const form = this.updateResForm || {}
                // 每项：留空=不改（不进入 patch）；'-'=删除（strategic merge patch 中用 null 表示）；其它=设置
                const buildSection = (cpu, memory) => {
                    const section = {}
                    const c = (cpu || '').trim()
                    const m = (memory || '').trim()
                    if (c) section.cpu = (c === '-') ? null : c
                    if (m) section.memory = (m === '-') ? null : m
                    return section
                }
                const requests = buildSection(form.request_cpu, form.request_memory)
                const limits = buildSection(form.limit_cpu, form.limit_memory)
                const resources = {}
                if (Object.keys(requests).length) resources.requests = requests
                if (Object.keys(limits).length) resources.limits = limits
                if (!Object.keys(resources).length) {
                    bootbox.alert('请至少填写一项要更新的资源（留空表示不修改，填 - 表示删除该项）')
                    return
                }
                // strategic merge patch：containers 按 name 合并，只改指定容器的 resources
                const patch = {
                    spec: {
                        template: {
                            spec: {
                                containers: [
                                    { name: containerName, resources: resources },
                                ],
                            },
                        },
                    },
                }
                try {
                    this.updatingResource = true
                    bootboxLoading('更新资源中...')
                    const url = '/api/k3s/patch/' + encodeURIComponent(r)
                    const resp = await axios.post(url, patch, {
                        params: { name: name, namespace: ns, type: 'strategic' },
                    })
                    bootbox.hideAll()
                    if (!resp.data || resp.data.code !== 0) {
                        bootbox.alert('更新资源失败：' + ((resp.data && resp.data.message) || '未知错误'))
                        return
                    }
                    $('#k3sUpdateResourceModal').modal('hide')
                    bootbox.alert('更新资源成功（容器：' + containerName + '）', async () => {
                        await this.fetchList()
                    })
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert('更新资源失败：' + (e && e.message ? e.message : e))
                } finally {
                    this.updatingResource = false
                }
            },
            openScheduleModal(item) {
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                const r = (this.currentResource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法设置调度')
                    return
                }
                if (!this.isScheduleSupported) {
                    bootbox.alert('当前资源不支持设置调度')
                    return
                }
                const podSpec = (item && item.spec && item.spec.template && item.spec.template.spec) || {}
                const current = {}
                const ns0 = podSpec.nodeSelector || {}
                Object.keys(ns0).forEach((k) => {
                    current[k] = ns0[k] == null ? '' : String(ns0[k])
                })
                this.scheduleTarget = { resource: r, name: name, namespace: ns }
                this.scheduleOriginal = Object.assign({}, current)
                this.scheduleSelector = Object.assign({}, current)
                this.scheduleFilter = ''
                this.scheduleCustomInput = ''
                this.scheduling = false
                // 节点数据只在页面加载时取过一次，没有的话补取，保证有 label 可选
                if (!this.nodeRows || !this.nodeRows.length) {
                    this.fetchNodes()
                }
                $('#k3sScheduleModal').modal('show')
            },
            isScheduleLabelSelected(key, value) {
                const sel = this.scheduleSelector || {}
                return Object.prototype.hasOwnProperty.call(sel, key) && sel[key] === value
            },
            toggleScheduleLabel(key, value) {
                // 每次都生成新对象，保证视图更新
                const next = Object.assign({}, this.scheduleSelector)
                if (this.isScheduleLabelSelected(key, value)) {
                    delete next[key]
                } else {
                    next[key] = value
                }
                this.scheduleSelector = next
            },
            removeScheduleKey(key) {
                const next = Object.assign({}, this.scheduleSelector)
                delete next[key]
                this.scheduleSelector = next
            },
            addScheduleCustom() {
                const text = (this.scheduleCustomInput || '').trim()
                if (!text) {
                    return
                }
                const idx = text.indexOf('=')
                if (idx < 0) {
                    bootbox.alert('格式错误，请输入 key=value')
                    return
                }
                const key = text.substring(0, idx).trim()
                const value = text.substring(idx + 1).trim()
                if (!key) {
                    bootbox.alert('label 的 key 不能为空')
                    return
                }
                this.scheduleSelector = Object.assign({}, this.scheduleSelector, { [key]: value })
                this.scheduleCustomInput = ''
            },
            async submitSchedule() {
                if (this.scheduling) {
                    return
                }
                const t = this.scheduleTarget || {}
                const name = (t.name || '').trim()
                const ns = (t.namespace || '').trim()
                const r = (t.resource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法设置调度')
                    return
                }
                const original = this.scheduleOriginal || {}
                const desired = this.scheduleSelector || {}
                // strategic merge patch 对 map 是逐 key 合并：新增/修改的 key 写值，需要移除的 key 写 null
                const nodeSelector = {}
                let changed = false
                Object.keys(desired).forEach((k) => {
                    if (!Object.prototype.hasOwnProperty.call(original, k) || original[k] !== desired[k]) {
                        nodeSelector[k] = desired[k]
                        changed = true
                    }
                })
                Object.keys(original).forEach((k) => {
                    if (!Object.prototype.hasOwnProperty.call(desired, k)) {
                        nodeSelector[k] = null
                        changed = true
                    }
                })
                if (!changed) {
                    bootbox.alert('nodeSelector 没有变化')
                    return
                }
                const patch = {
                    spec: {
                        template: {
                            spec: {
                                nodeSelector: nodeSelector,
                            },
                        },
                    },
                }
                try {
                    this.scheduling = true
                    bootboxLoading('保存调度中...')
                    const url = '/api/k3s/patch/' + encodeURIComponent(r)
                    const resp = await axios.post(url, patch, {
                        params: { name: name, namespace: ns, type: 'strategic' },
                    })
                    bootbox.hideAll()
                    if (!resp.data || resp.data.code !== 0) {
                        bootbox.alert('保存调度失败：' + ((resp.data && resp.data.message) || '未知错误'))
                        return
                    }
                    $('#k3sScheduleModal').modal('hide')
                    bootbox.alert('保存调度成功', async () => {
                        await this.fetchList()
                    })
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert('保存调度失败：' + (e && e.message ? e.message : e))
                } finally {
                    this.scheduling = false
                }
            },
            onApplyFileChange(e) {
                try {
                    const files = (e && e.target && e.target.files) ? e.target.files : []
                    if (!files || files.length < 1) {
                        return
                    }
                    const f = files[0]
                    this.applyFileName = (f && f.name) ? f.name : ''
                    const reader = new FileReader()
                    reader.onload = () => {
                        try {
                            const text = reader.result != null ? String(reader.result) : ''
                            this.applyYamlText = text
                            if (this.cmApplyEditor) {
                                this.cmApplyEditor.setValue(text)
                                this.cmApplyEditor.refresh()
                            }
                        } catch (err) {
                            bootbox.alert('读取文件失败：' + (err && err.message ? err.message : err))
                        }
                    }
                    reader.onerror = () => {
                        bootbox.alert('读取文件失败')
                    }
                    reader.readAsText(f)
                } catch (err) {
                    bootbox.alert('读取文件失败：' + (err && err.message ? err.message : err))
                }
            },
            async submitApplyYaml() {
                const raw = this.cmApplyEditor ? this.cmApplyEditor.getValue() : this.applyYamlText
                const text = (raw || '').trim()
                if (!text) {
                    bootbox.alert('请填写 YAML 内容')
                    return
                }
                if (this.applying) {
                    return
                }
                try {
                    this.applying = true
                    this.applyResults = []
                    bootboxLoading('Applying...')
                    const result = await axios.post('/api/k3s/apply', text, {
                        headers: { 'Content-Type': 'text/plain' },
                        transformRequest: [(d) => d],
                    })
                    bootbox.hideAll()
                    this.applying = false
                    if (!result.data || result.data.code !== 0) {
                        bootbox.alert('Apply 失败：' + ((result.data && result.data.message) || '未知错误'))
                        return
                    }
                    const list = result.data.data || []
                    this.applyResults = Array.isArray(list) ? list : []

                    let hasOk = false
                    for (let i = 0; i < this.applyResults.length; i++) {
                        const r = this.applyResults[i]
                        if (r && (r.action === 'created' || r.action === 'updated')) {
                            hasOk = true
                            break
                        }
                    }
                    if (hasOk) {
                        await this.fetchList()
                    }
                } catch (e) {
                    bootbox.hideAll()
                    this.applying = false
                    bootbox.alert('Apply 失败：' + (e && e.message ? e.message : e))
                }
            },
            initFromQuery() {
                const qNs = (typeof getQuery === 'function' ? getQuery('namespace', '') : '')
                const qRes = (typeof getQuery === 'function' ? getQuery('resource', '') : '')
                if (qRes) {
                    const v = String(qRes).trim()
                    const ok = this.resourceList.some((r) => r && r.value === v)
                    if (ok) {
                        this.currentResource = v
                    }
                }
                if (qNs) {
                    this.currentNamespace = String(qNs).trim()
                }
            },
            syncQueryToUrl() {
                try {
                    const url = new URL(window.location.href)
                    const ns = (this.currentNamespace || '').trim()
                    const r = (this.currentResource || '').trim()
                    if (ns) {
                        url.searchParams.set('namespace', ns)
                    } else {
                        url.searchParams.delete('namespace')
                    }
                    if (r) {
                        url.searchParams.set('resource', r)
                    } else {
                        url.searchParams.delete('resource')
                    }
                    window.history.replaceState({}, '', url.toString())
                } catch (e) {
                    // ignore
                }
            },
            async fetchNamespaces() {
                try {
                    const result = await axios.get('/api/k3s/list/namespace')
                    bootbox.hideAll()
                    if (!result.data || result.data.code !== 0) {
                        bootbox.alert('加载namespace失败：' + ((result.data && result.data.message) || '未知错误'))
                        this.namespaceList = []
                        return
                    }
                    const items = (result.data.data && result.data.data.items) ? result.data.data.items : []
                    const list = []
                    for (let i = 0; i < items.length; i++) {
                        const meta = this.getMeta(items[i])
                        if (meta && meta.name) {
                            list.push(meta.name)
                        }
                    }
                    this.namespaceList = list
                    if (!this.currentNamespace && list.length > 0) {
                        // 默认优先选 business namespace（忽略大小写）
                        let picked = ''
                        for (let i = 0; i < list.length; i++) {
                            const n = (list[i] || '')
                            if (String(n).toLowerCase().indexOf('business') >= 0) {
                                picked = n
                                break
                            }
                        }
                        this.currentNamespace = picked || list[0]
                    }
                } catch (e) {
                    bootbox.hideAll()
                    this.namespaceList = []
                    bootbox.alert('加载namespace失败：' + (e && e.message ? e.message : e))
                }
            },
            async fetchList(silent) {
                const ns = (this.currentNamespace || '').trim()
                const r = (this.currentResource || '').trim()
                if (!ns || !r) {
                    return
                }
                if (this.fetchingList) {
                    return
                }
                try {
                    this.fetchingList = true
                    const url = '/api/k3s/list/' + encodeURIComponent(r) + '?namespace=' + encodeURIComponent(ns)
                    const result = await axios.get(url)
                    if (!result.data || result.data.code !== 0) {
                        if (!silent) {
                            bootbox.alert('加载资源失败：' + ((result.data && result.data.message) || '未知错误'))
                            this.rows = []
                        }
                        return
                    }
                    const data = result.data.data || {}
                    const items = data.items || []
                    this.rows = items
                } catch (e) {
                    console && console.warn && console.warn('silent fetchList failed', e)
                } finally {
                    this.fetchingList = false
                }
            },
            getMeta(item) {
                if (!item) {
                    return { name: '', namespace: '', uid: '', creationTimestamp: '' }
                }
                const m = item.metadata || item.meta || {}
                return {
                    name: m.name || '',
                    namespace: m.namespace || '',
                    uid: m.uid || '',
                    creationTimestamp: m.creationTimestamp || '',
                }
            },
            getAge(item) {
                const ts = this.getMeta(item).creationTimestamp
                if (!ts) {
                    return ''
                }
                // 不依赖 dayjs relativeTime 插件（页面未加载，fromNow 不存在），自己算成 1s / 2m / 3h / 5d
                const created = Date.parse(ts)
                if (isNaN(created)) {
                    return ts
                }
                // 本机时钟比集群快/慢时可能出现负数，按 0 处理
                const sec = Math.max(0, Math.floor((Date.now() - created) / 1000))
                if (sec < 60) return sec + 's'
                const min = Math.floor(sec / 60)
                if (min < 60) return min + 'm'
                const hour = Math.floor(min / 60)
                if (hour < 24) return hour + 'h'
                return Math.floor(hour / 24) + 'd'
            },
            getContainers(item) {
                const spec = (item && item.spec) || {}
                const tmpl = spec.template || {}
                const podSpec = tmpl.spec || {}
                return Array.isArray(podSpec.containers) ? podSpec.containers : []
            },
            formatContainerResources(item, kind) {
                // kind: 'requests' | 'limits'
                const containers = this.getContainers(item)
                if (!containers.length) return ''
                const parts = []
                for (let i = 0; i < containers.length; i++) {
                    const c = containers[i] || {}
                    const res = c.resources || {}
                    const r = res[kind] || {}
                    const cpu = r.cpu != null ? r.cpu : '-'
                    const mem = r.memory != null ? r.memory : '-'
                    if (cpu === '-' && mem === '-') {
                        continue
                    }
                    const label = containers.length > 1 ? (c.name || ('#' + i)) + ': ' : ''
                    parts.push(`${label}cpu=${cpu} mem=${mem}`)
                }
                return parts.join('; ')
            },
            renderCell(item, key) {
                try {
                    if (key === 'age') {
                        return this.getAge(item)
                    }
                    const r = (this.currentResource || '').toLowerCase()
                    if (key.startsWith('deploy_')) {
                        const st = (item && item.status) || {}
                        const ready = st.readyReplicas || 0
                        const replicas = st.replicas || 0
                        if (key === 'deploy_ready') return `${ready}/${replicas}`
                        if (key === 'deploy_available') return st.availableReplicas != null ? st.availableReplicas : ''
                        if (key === 'deploy_requestResource') return this.formatContainerResources(item, 'requests')
                        if (key === 'deploy_limitResource') return this.formatContainerResources(item, 'limits')
                    }
                    if (key.startsWith('svc_')) {
                        const spec = (item && item.spec) || {}
                        if (key === 'svc_type') return spec.type || ''
                        if (key === 'svc_clusterIP') return spec.clusterIP || ''
                        if (key === 'svc_ports') {
                            const ports = spec.ports || []
                            return ports.map(p => {
                                const port = p.port != null ? p.port : ''
                                const targetPort = p.targetPort != null ? p.targetPort : ''
                                const protocol = p.protocol || ''
                                return `${port}:${targetPort}/${protocol}`
                            }).join(', ')
                        }
                    }
                    if (key.startsWith('pod_')) {
                        const st = (item && item.status) || {}
                        const spec = (item && item.spec) || {}
                        if (key === 'pod_status') {
                            const meta = this.getMeta(item)
                            const deletionTs = (item && item.metadata && item.metadata.deletionTimestamp) ? item.metadata.deletionTimestamp : ''
                            if (deletionTs) {
                                return 'Terminating'
                            }
                            // 部分集群会把 deletionTimestamp 放在 metadata 里但 getMeta 未返回，这里兜底
                            if (meta && meta.deletionTimestamp) {
                                return 'Terminating'
                            }
                            return st.phase || ''
                        }
                        if (key === 'pod_node') return spec.nodeName || ''
                        if (key === 'pod_node_ip') {
                            const nodeName = spec.nodeName || ''
                            if (!nodeName || !this.nodeRows || !this.nodeRows.length) return ''
                            for (let i = 0; i < this.nodeRows.length; i++) {
                                if (this.nodeRows[i] && this.nodeRows[i].name === nodeName) {
                                    return this.nodeRows[i].internal_ip || ''
                                }
                            }
                            return ''
                        }
                        if (key === 'pod_ready') {
                            const cs = st.containerStatuses || []
                            let ready = 0
                            for (let i = 0; i < cs.length; i++) {
                                if (cs[i] && cs[i].ready) ready++
                            }
                            return `${ready}/${cs.length}`
                        }
                        if (key === 'pod_restarts') {
                            const cs = st.containerStatuses || []
                            let total = 0
                            for (let i = 0; i < cs.length; i++) {
                                total += (cs[i] && cs[i].restartCount) ? cs[i].restartCount : 0
                            }
                            return total
                        }
                    }
                    if (key.startsWith('cj_')) {
                        const spec = (item && item.spec) || {}
                        const st = (item && item.status) || {}
                        if (key === 'cj_schedule') return spec.schedule || ''
                        if (key === 'cj_suspend') return spec.suspend === true ? 'true' : (spec.suspend === false ? 'false' : '')
                        if (key === 'cj_lastSchedule') return st.lastScheduleTime || ''
                        if (key === 'cj_active') return (st.active && st.active.length) ? st.active.length : 0
                    }
                    if (key.startsWith('cm_')) {
                        const data = (item && item.data) || {}
                        if (key === 'cm_dataCount') return data ? Object.keys(data).length : 0
                        if (key === 'cm_immutable') return item.immutable === true ? 'true' : (item.immutable === false ? 'false' : '')
                    }
                    if (key.startsWith('ds_')) {
                        const st = (item && item.status) || {}
                        if (key === 'ds_desired') return st.desiredNumberScheduled != null ? st.desiredNumberScheduled : ''
                        if (key === 'ds_current') return st.currentNumberScheduled != null ? st.currentNumberScheduled : ''
                        if (key === 'ds_ready') return st.numberReady != null ? st.numberReady : ''
                        if (key === 'ds_upToDate') return st.updatedNumberScheduled != null ? st.updatedNumberScheduled : ''
                    }
                    if (key.startsWith('sts_')) {
                        const st = (item && item.status) || {}
                        if (key === 'sts_ready') return `${st.readyReplicas || 0}/${st.replicas || 0}`
                        if (key === 'sts_current') return st.currentReplicas != null ? st.currentReplicas : ''
                        if (key === 'sts_updateRevision') return st.updateRevision || ''
                    }
                    if (key.startsWith('sa_')) {
                        if (key === 'sa_secrets') return (item.secrets && item.secrets.length) ? item.secrets.length : 0
                        if (key === 'sa_automount') {
                            const v = item.automountServiceAccountToken
                            return v === true ? 'true' : (v === false ? 'false' : '')
                        }
                    }
                    if (key.startsWith('ir_')) {
                        const spec = (item && item.spec) || {}
                        if (key === 'ir_entryPoints') {
                            const eps = spec.entryPoints || []
                            return Array.isArray(eps) ? eps.join(', ') : ''
                        }
                        if (key === 'ir_tls') {
                            return spec.tls ? 'true' : ''
                        }
                        if (key === 'ir_routes') {
                            const routes = spec.routes || []
                            if (!Array.isArray(routes) || routes.length < 1) return 0
                            const first = routes[0] || {}
                            const m = first.match || ''
                            return m ? `${routes.length} | ${m}` : routes.length
                        }
                    }

                    // fallback
                    if (r) {
                        return ''
                    }
                } catch (e) {
                    return ''
                }
                return ''
            },
            async showDetail(item) {
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                const r = (this.currentResource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法查询详情')
                    return
                }
                try {
                    bootboxLoading('查询详情中...')
                    const url = '/api/k3s/get/' + encodeURIComponent(r) + '?name=' + encodeURIComponent(name) + '&namespace=' + encodeURIComponent(ns) + '&format=yaml'
                    const result = await axios.get(url, {
                        responseType: 'text',
                        transformResponse: [(d) => d],
                    })
                    bootbox.hideAll()
                    const text = result && result.data != null ? String(result.data) : ''
                    // 兼容后端返回 JSON 错误结构（code/message）
                    try {
                        const o = JSON.parse(text)
                        if (o && o.code != null && o.code !== 0) {
                            bootbox.alert('查询详情失败：' + (o.message || '未知错误'))
                            return
                        }
                    } catch (e) {
                        // ignore, treat as yaml
                    }
                    this.detailTitle = `${r} ${ns}/${name}`
                    this.detailYaml = text
                    const safeName = String(`${r}_${ns}_${name}`).replace(/[^a-zA-Z0-9_.-]+/g, '_')
                    this.detailDownloadName = `${safeName}.yaml`
                    this.openDetailModal('yaml')
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert('查询详情失败：' + (e && e.message ? e.message : e))
                }
            },
            async showPodLog(item) {
                if (!this.isPodResource) {
                    bootbox.alert('当前 resource 不是 pod，无法查看日志')
                    return
                }
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                if (!name) {
                    bootbox.alert('缺少 pod name，无法获取日志')
                    return
                }
                try {
                    bootboxLoading('加载日志…')
                    const url = '/api/k3s/log/' + encodeURIComponent(name)
                    const result = await axios.get(url, {
                        params: {
                            namespace: ns,
                            tail: 1000,
                        },
                    })
                    bootbox.hideAll()
                    if (!result.data || result.data.code !== 0) {
                        bootbox.alert('获取日志失败：' + ((result.data && result.data.message) || '未知错误'))
                        return
                    }
                    const d = result.data.data || {}
                    const log = d.log != null ? String(d.log) : ''
                    this.podLogTitle = `Pod 日志（最近 1000 行）${ns}/${name}`
                    this.podLogText = log
                    $('#k3sPodLogModal').modal('show')
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert('获取日志失败：' + (e && e.message ? e.message : e))
                }
            },
            async downloadPodLog(item) {
                if (!this.isPodResource) {
                    bootbox.alert('当前 resource 不是 pod，无法下载日志')
                    return
                }
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                if (!name) {
                    bootbox.alert('缺少 pod name，无法下载日志')
                    return
                }
                try {
                    bootboxLoading('下载日志中…')
                    const url = '/api/k3s/log/' + encodeURIComponent(name)
                    const result = await axios.get(url, {
                        params: {
                            namespace: ns,
                            tail: 0,
                        },
                    })
                    bootbox.hideAll()
                    if (!result.data || result.data.code !== 0) {
                        bootbox.alert('获取日志失败：' + ((result.data && result.data.message) || '未知错误'))
                        return
                    }
                    const d = result.data.data || {}
                    const log = d.log != null ? String(d.log) : ''
                    const safeNs = String(ns || '').replace(/[^a-zA-Z0-9_.-]+/g, '_')
                    const safeName = String(name || '').replace(/[^a-zA-Z0-9_.-]+/g, '_')
                    const fileName = `pod-log_${safeNs}_${safeName}.log`
                    saveFile(log, fileName)
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert('下载日志失败：' + (e && e.message ? e.message : e))
                }
            },
            async deleteResource(item) {
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                const r = (this.currentResource || '').trim()
                if (!name || !r) {
                    bootbox.alert('缺少 name/resource，无法删除')
                    return
                }
                bootbox.confirm(`确认删除 ${r} ${ns}/${name} ?`, async (yes) => {
                    if (!yes) {
                        return
                    }
                    try {
                        bootboxLoading('删除中...')
                        const url = '/api/k3s/delete/' + encodeURIComponent(r)
                        const result = await axios.delete(url, {
                            params: {
                                name: name,
                                namespace: ns,
                            }
                        })
                        bootbox.hideAll()
                        if (!result.data || result.data.code !== 0) {
                            bootbox.alert('删除失败：' + ((result.data && result.data.message) || '未知错误'))
                            return
                        }
                        bootbox.alert('删除成功', async () => {
                            await this.fetchList()
                        })
                    } catch (e) {
                        bootbox.hideAll()
                        bootbox.alert('删除失败：' + (e && e.message ? e.message : e))
                    }
                })
            },
            gotoImageManager() {
                window.open('/k3s/image2', '_blank')
            },
            // ====== 资源 YAML 编辑（ConfigMap / Deployment / Service / Cronjob / IngressRoute 等）======
            cmReplaceStorageKey() {
                return 'k3s_configmap_replace_rules'
            },
            loadReplaceRules() {
                try {
                    const raw = localStorage.getItem(this.cmReplaceStorageKey())
                    if (!raw) {
                        return []
                    }
                    const list = JSON.parse(raw)
                    if (!Array.isArray(list)) {
                        return []
                    }
                    // 仅保留结构正确的规则
                    return list
                        .filter((r) => r && typeof r === 'object')
                        .map((r) => ({ old: String(r.old == null ? '' : r.old), new: String(r.new == null ? '' : r.new) }))
                } catch (e) {
                    return []
                }
            },
            saveReplaceRules() {
                try {
                    const list = (this.cmReplaceRules || []).map((r) => ({ old: String(r.old || ''), new: String(r.new || '') }))
                    localStorage.setItem(this.cmReplaceStorageKey(), JSON.stringify(list))
                } catch (e) {
                    // ignore
                }
            },
            addReplaceRule() {
                this.cmReplaceRules.push({ old: '', new: '' })
            },
            removeReplaceRule(index) {
                this.cmReplaceRules.splice(index, 1)
                this.saveReplaceRules()
            },
            // 对编辑器全文做一次 old -> new 的全局替换
            replaceInEditor(oldText, newText) {
                if (!this.cmEditor || !oldText) {
                    return 0
                }
                const src = this.cmEditor.getValue()
                const parts = src.split(oldText)
                const count = parts.length - 1
                if (count > 0) {
                    this.cmEditor.setValue(parts.join(newText == null ? '' : newText))
                }
                return count
            },
            applyAllReplaceRules() {
                this.saveReplaceRules()
                if (!this.cmEditor) {
                    return
                }
                let total = 0
                for (let i = 0; i < this.cmReplaceRules.length; i++) {
                    const rule = this.cmReplaceRules[i]
                    if (rule && rule.old) {
                        total += this.replaceInEditor(rule.old, rule.new)
                    }
                }
                bootbox.alert('已应用全部替换规则，共替换 ' + total + ' 处')
            },
            reloadOriginalResource() {
                if (this.cmEditor) {
                    this.cmEditor.setValue(this.cmOriginalYaml || '')
                }
            },
            async openEditResourceModal(item) {
                const meta = this.getMeta(item)
                const name = meta.name
                const ns = meta.namespace || this.currentNamespace
                const r = (this.currentResource || '').trim()
                if (!name) {
                    bootbox.alert('缺少 name，无法编辑')
                    return
                }
                if (!r) {
                    bootbox.alert('缺少 resource，无法编辑')
                    return
                }
                try {
                    bootboxLoading('加载 ' + r + '...')
                    const url = '/api/k3s/get/' + encodeURIComponent(r) + '?name=' + encodeURIComponent(name) + '&namespace=' + encodeURIComponent(ns) + '&format=yaml'
                    const result = await axios.get(url, {
                        responseType: 'text',
                        transformResponse: [(d) => d],
                    })
                    bootbox.hideAll()
                    const text = result && result.data != null ? String(result.data) : ''
                    // 兼容后端返回 JSON 错误结构
                    try {
                        const o = JSON.parse(text)
                        if (o && o.code != null && o.code !== 0) {
                            bootbox.alert('加载失败：' + (o.message || '未知错误'))
                            return
                        }
                    } catch (e) {
                        // ignore, treat as yaml
                    }
                    this.cmEditTarget = { resource: r, name: name, namespace: ns }
                    this.cmOriginalYaml = text
                    this.cmReplaceRules = this.loadReplaceRules()
                    const $modal = $('#k3sEditResourceModal')
                    // 必须等模态框显示动画结束、容器拿到真实尺寸后再初始化 CodeMirror，
                    // 否则行高/高度会按隐藏容器测量，出现大片空白。用 shown.bs.modal 取代定时器。
                    $modal.off('shown.bs.modal.k3sedit').one('shown.bs.modal.k3sedit', () => {
                        const created = !this.cmEditor
                        this.ensureResourceEditor()
                        if (this.cmEditor) {
                            this.cmEditor.setValue(text)
                            // 自动套用已缓存的替换规则
                            for (let i = 0; i < this.cmReplaceRules.length; i++) {
                                const rule = this.cmReplaceRules[i]
                                if (rule && rule.old) {
                                    this.replaceInEditor(rule.old, rule.new)
                                }
                            }
                            // 首次创建时，DOM 尚未完成布局，同步 refresh 会按错误尺寸测量，
                            // 导致顶部出现大片空白且无法编辑；延迟到下一帧布局稳定后再刷新。
                            const refreshEditor = () => {
                                if (this.cmEditor) {
                                    this.cmEditor.refresh()
                                    this.cmEditor.focus()
                                }
                            }
                            if (created) {
                                requestAnimationFrame(() => requestAnimationFrame(refreshEditor))
                            } else {
                                refreshEditor()
                            }
                        }
                    })
                    $modal.modal('show')
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert('加载失败：' + (e && e.message ? e.message : e))
                }
            },
            ensureResourceEditor() {
                if (this.cmEditor) {
                    return
                }
                if (typeof CodeMirror === 'undefined') {
                    return
                }
                const el = document.getElementById('k3sResourceEditor')
                if (!el) {
                    return
                }
                this.cmEditor = CodeMirror.fromTextArea(el, {
                    mode: 'yaml',
                    theme: 'eclipse',
                    lineNumbers: true,
                    lineWrapping: false,
                    indentUnit: 2,
                    tabSize: 2,
                    styleActiveLine: true,
                })
                this.cmEditor.setSize('100%', '55vh')
            },
            async submitEditResource() {
                if (this.cmSaving) {
                    return
                }
                if (!this.cmEditor) {
                    bootbox.alert('编辑器未初始化')
                    return
                }
                const text = (this.cmEditor.getValue() || '').trim()
                if (!text) {
                    bootbox.alert('内容为空')
                    return
                }
                try {
                    this.cmSaving = true
                    bootboxLoading('保存中...')
                    const result = await axios.post('/api/k3s/apply', text, {
                        headers: { 'Content-Type': 'text/plain' },
                        transformRequest: [(d) => d],
                    })
                    bootbox.hideAll()
                    this.cmSaving = false
                    if (!result.data || result.data.code !== 0) {
                        bootbox.alert('保存失败：' + ((result.data && result.data.message) || '未知错误'))
                        return
                    }
                    const list = result.data.data || []
                    const first = Array.isArray(list) && list.length ? list[0] : null
                    if (first && first.action === 'error') {
                        bootbox.alert('保存失败：' + (first.error || '未知错误'))
                        return
                    }
                    this.saveReplaceRules()
                    $('#k3sEditResourceModal').modal('hide')
                    bootbox.alert('保存 + Apply 成功', async () => {
                        await this.fetchList()
                    })
                } catch (e) {
                    bootbox.hideAll()
                    this.cmSaving = false
                    bootbox.alert('保存失败：' + (e && e.message ? e.message : e))
                }
            }
        }
    }
</script>
