<template id="template">
    <div>
        <!-- 大标题 -->
        <div class="page-header">
            <h2>MySQL / FTP / OSS / SSH / Redis / 本地文件</h2>
        </div>

        <!-- 类型胶囊 Tab（nav-pills）+ 操作；切换由 activeType 驱动，见 changeType / activeRows -->
        <div class="clearfix" style="margin-bottom: 12px;">
            <div class="pull-right">
                <button class="btn btn-default btn-sm" @click="load" :disabled="loading">
                    <span class="glyphicon glyphicon-refresh"></span> 刷新
                </button>
                <button class="btn btn-primary btn-sm ml-10" @click="openCreate" :disabled="!activeMeta">
                    + 新建{{activeMeta ? ' ' + activeMeta.label : ''}}配置
                </button>
            </div>
            <ul class="nav nav-pills" role="tablist">
                <li v-for="meta in typeMetas" :key="meta.type" role="presentation"
                    :class="{ active: activeType === meta.type }">
                    <a href="javascript:void(0)" role="tab" :aria-selected="activeType === meta.type"
                        @click="changeType(meta.type)">
                        {{meta.label}} <span class="badge">{{typeCount(meta.type)}}</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- 当前类型的配置列表 -->
        <div class="table-responsive" v-if="activeMeta">
            <table class="table table-bordered table-condensed table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="width: 180px;">名称</th>
                        <th>{{activeMeta.host_label}}{{activeMeta.default_port > 0 ? ' : 端口' : ''}}</th>
                        <th style="width: 140px;" v-if="!activeMeta.hide_auth">{{activeMeta.user_label}}</th>
                        <th v-for="field in activeExtraFields" :key="field.key">{{field.label}}</th>
                        <th style="width: 150px;">更新时间</th>
                        <th style="width: 160px;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="(item, i) in activeRows" :key="item.id">
                        <td>{{i + 1}}</td>
                        <td>
                            <a v-if="item.type === 'mysql'" :href="'/mysql/' + item.id"><strong>{{item.name}}</strong></a>
                            <a v-else-if="item.type === 'fs'" :href="'/fs/' + item.id"><strong>{{item.name}}</strong></a>
                            <strong v-else>{{item.name}}</strong>
                        </td>
                        <td style="white-space: nowrap;">{{item.host}}{{item.port > 0 ? ':' + item.port : ''}}</td>
                        <td v-if="!activeMeta.hide_auth">{{item.username}}</td>
                        <td v-for="field in activeExtraFields" :key="field.key" style="word-break: break-all;">
                            {{item.extra ? item.extra[field.key] : ''}}
                        </td>
                        <td>{{item.updated_at}}</td>
                        <td>
                            <button class="btn btn-xs btn-link" style="padding: 0 4px;" @click="testOne(item)"
                                :disabled="testing[item.id] === true">
                                {{testing[item.id] ? '测试中...' : '测试'}}
                            </button>
                            <button class="btn btn-xs btn-link" style="padding: 0 4px;" @click="openEdit(item)">编辑</button>
                            <button class="btn btn-xs btn-link text-danger" style="padding: 0 4px;"
                                @click="removeOne(item)">删除</button>
                        </td>
                    </tr>
                    <tr v-if="activeRows.length < 1">
                        <td :colspan="(activeMeta.hide_auth ? 5 : 6) + activeExtraFields.length" style="text-align: center; color: #999;">
                            {{loading ? '加载中...' : '暂无 ' + activeMeta.label + ' 配置，点击右上角「新建」添加'}}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- 新建 / 编辑 弹窗 -->
        <div class="modal fade" id="configModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
                                aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title">{{editingId > 0 ? '编辑配置（' + typeLabel(form.type) + '）' : '新建配置'}}</h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">类型<span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <select class="form-control input-sm" v-model="form.type"
                                        :disabled="editingId > 0" @change="onTypeChange">
                                        <option v-for="meta in typeMetas" :key="meta.type" :value="meta.type">
                                            {{meta.label}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">名称<span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control input-sm" v-model="form.name"
                                        placeholder="如：prod-mysql-main / 内网-FTP" />
                                </div>
                            </div>
                            <div class="form-group" v-if="currentMeta">
                                <label class="col-sm-3 control-label">{{currentMeta.host_label}}<span
                                        class="text-danger" v-if="currentMeta.require_host">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control input-sm" v-model="form.host"
                                        :placeholder="currentMeta.host_placeholder" />
                                </div>
                            </div>
                            <div class="form-group" v-if="currentMeta && !currentMeta.hide_port">
                                <label class="col-sm-3 control-label">端口</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control input-sm" v-model.number="form.port"
                                        :placeholder="currentMeta.default_port > 0 ? '默认 ' + currentMeta.default_port : '可选'" />
                                </div>
                            </div>
                            <div class="form-group" v-if="currentMeta && !currentMeta.hide_auth">
                                <label class="col-sm-3 control-label">{{currentMeta.user_label}}</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control input-sm" v-model="form.username" />
                                </div>
                            </div>
                            <div class="form-group" v-if="currentMeta && !currentMeta.hide_auth">
                                <label class="col-sm-3 control-label">{{currentMeta.password_label}}</label>
                                <div class="col-sm-8">
                                    <input type="password" class="form-control input-sm" v-model="form.password"
                                        :placeholder="editingId > 0 ? '留空则保留原密码' : ''" autocomplete="new-password" />
                                </div>
                            </div>
                            <div class="form-group" v-for="field in extraFields" :key="field.key">
                                <label class="col-sm-3 control-label">{{field.label}}<span class="text-danger"
                                        v-if="field.required">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control input-sm" v-model="form.extra[field.key]"
                                        :placeholder="field.placeholder" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <span class="text-danger" style="float: left;" v-if="formError">{{formError}}</span>
                        <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                        <button type="button" class="btn btn-primary" @click="save" :disabled="saving">
                            {{saving ? '保存中...' : '保存'}}
                        </button>
                    </div>
                </div>
            </div>
        </div>

          <!-- 大标题 -->
        <div class="page-header">
            <h2>常用工具</h2>
        </div>
        <div>
            <a href="/tool/json" class="btn btn-link">JSON 工具</a>
            <a href="/tool/qrcode" class="btn btn-link">二维码生成</a>
            <a href="/tool/jsrun" class="btn btn-link">运行 JS 代码</a>
        </div>
    </div>
</template>

<script>
    window.VueObject = {
        data() {
            return {
                typeMetas: [],
                activeType: '',
                rows: [],
                loading: false,
                testing: {},
                editingId: 0,
                saving: false,
                formError: '',
                form: {
                    type: '',
                    name: '',
                    host: '',
                    port: null,
                    username: '',
                    password: '',
                    extra: {},
                },
            }
        },
        computed: {
            currentMeta() {
                return this.typeMetas.find(m => m.type === this.form.type) || null
            },
            extraFields() {
                return this.currentMeta ? (this.currentMeta.extra_fields || []) : []
            },
            activeMeta() {
                return this.typeMetas.find(m => m.type === this.activeType) || null
            },
            activeExtraFields() {
                return this.activeMeta ? (this.activeMeta.extra_fields || []) : []
            },
            // 一次拉取全部配置，按当前 Tab 在前端过滤，保证各 Tab 计数准确
            activeRows() {
                return this.rows.filter(r => r.type === this.activeType)
            },
        },
        async mounted() {
            await this.loadTypes()
            await this.load()
        },
        methods: {
            async loadTypes() {
                try {
                    const resp = await axios.get('/api/config/types')
                    if (resp.data && resp.data.code === 0) {
                        this.typeMetas = resp.data.data || []
                        const queryType = getQuery('type', '')
                        if (this.typeMetas.some(m => m.type === queryType)) {
                            this.activeType = queryType
                        } else if (!this.activeType && this.typeMetas.length > 0) {
                            this.activeType = this.typeMetas[0].type
                        }
                    }
                } catch (e) {
                    console.error('load types error', e)
                }
            },
            async load() {
                this.loading = true
                try {
                    const resp = await axios.get('/api/config/list')
                    if (resp.data && resp.data.code === 0) {
                        this.rows = resp.data.data || []
                    } else {
                        bootbox.alert('加载失败：' + ((resp.data && resp.data.message) || '未知错误'))
                    }
                } catch (e) {
                    bootbox.alert('加载失败：' + e.message)
                } finally {
                    this.loading = false
                }
            },
            changeType(type) {
                this.activeType = type
            },
            typeCount(type) {
                return this.rows.filter(r => r.type === type).length
            },
            typeLabel(type) {
                const meta = this.typeMetas.find(m => m.type === type)
                return meta ? meta.label : type
            },
            onTypeChange() {
                this.form.port = this.currentMeta && this.currentMeta.default_port > 0
                    ? this.currentMeta.default_port : null
                this.form.extra = {}
            },
            openCreate() {
                this.editingId = 0
                this.formError = ''
                this.form = {
                    type: this.activeType,
                    name: '',
                    host: '',
                    port: null,
                    username: '',
                    password: '',
                    extra: {},
                }
                if (this.currentMeta && this.currentMeta.default_port > 0) {
                    this.form.port = this.currentMeta.default_port
                }
                window.jQuery('#configModal').modal('show')
            },
            openEdit(row) {
                this.editingId = row.id
                this.formError = ''
                this.form = {
                    type: row.type,
                    name: row.name,
                    host: row.host,
                    port: row.port > 0 ? row.port : null,
                    username: row.username,
                    password: '',
                    extra: Object.assign({}, row.extra || {}),
                }
                window.jQuery('#configModal').modal('show')
            },
            validateForm() {
                if (!this.form.type) return '请选择类型'
                if (!this.form.name.trim()) return '请输入名称'
                if (this.currentMeta && this.currentMeta.require_host && !this.form.host.trim()) {
                    return this.currentMeta.host_label + ' 不能为空'
                }
                for (const field of this.extraFields) {
                    if (field.required && !(this.form.extra[field.key] || '').trim()) {
                        return field.label + ' 不能为空'
                    }
                }
                return ''
            },
            async save() {
                this.formError = this.validateForm()
                if (this.formError) return
                this.saving = true
                try {
                    const payload = {
                        type: this.form.type,
                        name: this.form.name.trim(),
                        host: this.form.host.trim(),
                        port: this.form.port || 0,
                        username: this.form.username,
                        password: this.form.password,
                        extra: this.form.extra,
                    }
                    const url = this.editingId > 0
                        ? '/api/config/update/' + this.editingId
                        : '/api/config/create'
                    const resp = await axios.post(url, payload)
                    if (resp.data && resp.data.code === 0) {
                        window.jQuery('#configModal').modal('hide')
                        this.activeType = this.form.type
                        await this.load()
                    } else {
                        this.formError = (resp.data && resp.data.message) || '保存失败'
                    }
                } catch (e) {
                    this.formError = '保存失败：' + e.message
                } finally {
                    this.saving = false
                }
            },
            async testOne(row) {
                this.testing = Object.assign({}, this.testing, { [row.id]: true })
                try {
                    const resp = await axios.post('/api/config/test/' + row.id, {})
                    const result = resp.data && resp.data.code === 0 ? resp.data.data : null
                    if (result) {
                        if (result.ok) {
                            bootbox.alert({
                                title: '连接成功：' + row.name,
                                message: '<span class="text-success">连接成功，耗时 ' + result.cost_ms + 'ms</span>',
                            })
                        } else {
                            bootbox.alert({
                                title: '连接失败：' + row.name,
                                message: '<span class="text-danger">' + result.message + '</span>',
                            })
                        }
                    } else {
                        bootbox.alert('测试失败：' + ((resp.data && resp.data.message) || '未知错误'))
                    }
                } catch (e) {
                    bootbox.alert('测试失败：' + e.message)
                } finally {
                    const next = Object.assign({}, this.testing)
                    delete next[row.id]
                    this.testing = next
                }
            },
            removeOne(row) {
                bootbox.confirm('确认删除配置「' + row.name + '」？该操作不可恢复。', async (confirmed) => {
                    if (!confirmed) return
                    try {
                        const resp = await axios.post('/api/config/delete/' + row.id, {})
                        if (resp.data && resp.data.code === 0) {
                            await this.load()
                        } else {
                            bootbox.alert('删除失败：' + ((resp.data && resp.data.message) || '未知错误'))
                        }
                    } catch (e) {
                        bootbox.alert('删除失败：' + e.message)
                    }
                })
            },
        },
        template: '#template',
    }
</script>

