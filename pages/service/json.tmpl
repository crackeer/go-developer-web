<template id="template">
    <div id="jsoneditor" style="width: 100%; height: calc(100vh - 190px);"></div>
    <div class="modal fade" tabindex="-1" role="dialog" id="myModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">JSON字符串</h4>
                </div>
                <div class="modal-body">
                    <pre v-html="content"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    <input type="file" ref="fileInput" accept=".json,application/json,text/plain" style="display:none;"
        @change="onFileChosen" />
    <div class="fixed-bottom bg-light" style="padding: 10px 7.5%; text-align: center;">
        <button type="button" @click="this.saveJSON2" class="btn btn-outline-primary">保存</button>
        <button type="button" @click="this.json2String" class="btn btn-outline-primary">转字符串</button>
        <button type="button" @click="this.loadFromFile" class="btn btn-outline-primary">从文件加载</button>
        <button type="button" @click="this.deepParse" class="btn btn-outline-primary">递归解析</button>
    </div>
</template>
<script>
    function getInitJSON() {
        try {
            let value = localStorage.getItem("json-editor") || '{}'
            return JSON.parse(value)
        } catch (e) {
            return {}
        }
    }
    window.VueObject = {
        data() {
            return {
                content: '',
            }
        },
        template: '#template',
        canvas: null,
        editor: null,
        async mounted() {
            await this.initGetJSON()
        },
        methods: {
            async initGetJSON() {
                const container = document.getElementById("jsoneditor")
                const options = {
                    "mode": "code",
                    "search": true,
                    "indentation": 4,
                    "onChangeText": (json) => {
                        try {
                            JSON.parse(json)
                            localStorage.setItem("json-editor", json)
                        } catch (e) {

                        }
                    }
                }
                this.editor = new JSONEditor(container, options, getInitJSON())
            },
            async saveJSON2() {
                bootbox.prompt("请输入名称", (fname) => {
                    if (fname == null || fname == '') {
                        return true
                    }
                    saveFile(JSON.stringify(this.editor.get()), fname + ".json") 
                })

            },
            async setJSON(item) {
                let content = localStorage.getItem('JSON-' + item)
                try {
                    let data = JSON.parse(content)
                    this.editor.set(data)
                    this.currentName = item
                } catch (e) {
                }
                this.canvas.hide()
            },
            async json2String() {
                //this.content = JSON.stringify(this.editor.get())
                //$('#myModal').modal('show')
                this.editor.set(JSON.stringify(this.editor.get()))
            },
            loadFromFile() {
                const input = this.$refs.fileInput
                if (!input) return
                input.value = ''
                input.click()
            },
            onFileChosen(e) {
                const file = e.target.files && e.target.files[0]
                if (!file) return
                const reader = new FileReader()
                reader.onload = () => {
                    const text = reader.result + ''
                    try {
                        const obj = JSON.parse(text)
                        this.editor.set(obj)
                        localStorage.setItem('json-editor', JSON.stringify(obj))
                    } catch (err) {
                        bootbox.alert('JSON 解析失败：' + (err && err.message ? err.message : err))
                    }
                }
                reader.onerror = () => {
                    bootbox.alert('读取文件失败')
                }
                reader.readAsText(file)
            },
            deepParse() {
                let current
                try {
                    current = this.editor.get()
                } catch (e) {
                    bootbox.alert('当前编辑器内容不是合法 JSON')
                    return
                }
                const MAX_DEPTH = 32
                const walk = (value, depth) => {
                    if (depth > MAX_DEPTH) return value
                    if (typeof value === 'string') {
                        const trimmed = value.trim()
                        if (trimmed.length >= 2 && (trimmed[0] === '{' || trimmed[0] === '[')) {
                            try {
                                return walk(JSON.parse(trimmed), depth + 1)
                            } catch (e) {
                                return value
                            }
                        }
                        return value
                    }
                    if (Array.isArray(value)) {
                        for (let i = 0; i < value.length; i++) {
                            value[i] = walk(value[i], depth + 1)
                        }
                        return value
                    }
                    if (value && typeof value === 'object') {
                        for (const k of Object.keys(value)) {
                            value[k] = walk(value[k], depth + 1)
                        }
                        return value
                    }
                    return value
                }
                const expanded = walk(current, 0)
                this.editor.set(expanded)
                try {
                    localStorage.setItem('json-editor', JSON.stringify(expanded))
                } catch (e) { }
            }
        }
    }
</script>
<style>
    .fixed-bottom .btn {
        margin: .25rem .35rem;
    }
</style>