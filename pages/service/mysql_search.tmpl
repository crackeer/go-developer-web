<template id="template">
    <div class="well row">
         <div class="col-md-2">
            <select class="form-control" v-model="database">
                <option v-for="item in databases" :value="item">{{item}}</option>
            </select>
         </div>
        <div class="col-md-4">
            <input type="text" class="form-control" v-model="keyword" placeholder="关键词,请至少输入3个字符" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary" @click="doSearch" :disabled="loading">
                {{loading ? '搜索' + table + '中..' : '搜索'}}
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <template v-for="(item, i) in tableData">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <div class="panel-title">
                            {{item.table}}
                        </div>
                    </div>
                    <div class="panel-body">
                        <template v-for="(item1, i) in item.data">
                            <textarea class="form-control" rows="3" style="margin-top: 5px;">{{JSON.stringify(item1, null, 4)}}</textarea>
                        </template>
                    </div>
                </div>
            </template>
        </div>
    </div>

</template>
<script>
    const PageSize = 200
    window.VueObject = {
        data() {
            return {
                keyword: '',
                loading: false,
                databases: [],
                database: '',
                table: '',
                tableData: [],
            }
        },
        template: '#template',
        async mounted() {
            await this.getDatabases()
        },
        methods: {
            async doSearch() {
                if(this.keyword.length < 3) {
                    bootbox.alert('请输入至少3个字符')
                    return
                }
                this.loading = true
                this.tableData = []
                console.log(this.keyword)
                let allTableData = []
                let tables = await this.getTables(this.database)
                for (let j = 0; j < tables.length; j++) {
                    this.table = tables[j]
                    await sleep(300)
                    let stop = false
                    let page = 1
                    let tableData = []
                    while (!stop) {
                        let result = await this.searchTableData(this.database, this.table, page)
                        if (result.length < parseInt(PageSize)) {
                            stop = true
                        }
                        tableData = tableData.concat(result)
                        page++
                    }
                    if (tableData.length > 0) {
                        allTableData.push({
                            table: this.table,
                            data: tableData
                        })
                    }
                }
                this.tableData = allTableData
                this.loading = false
            },
            async getDatabases() {
                let result = await axios.get('/api/mysql/database')
                this.databases = result.data.data.filter(t => t.indexOf('Apollo') < 0)
                this.database = this.databases[0]
            },
            async getTables(database) {
                let result = await axios.get('/api/mysql/table/' + database)
                return result.data.data
            },
            async searchTableData(database, table, page) {
                this.loading = true
                this.totalPage = 0
                this.tableData = []
                let result = await axios.post('/api/mysql/query/' + database + '/' + table, {
                    page: parseInt(page),
                    page_size: parseInt(PageSize),
                })
                if (result.data.code != 0) {
                    return []
                }
                let retData = []
                for (let i = 0; i < result.data.data.length; i++) {
                    let content = JSON.stringify(result.data.data[i])
                    if (this.keyword.length > 0 && content.indexOf(this.keyword) > -1) {
                        retData.push(result.data.data[i])
                    }
                }
                return retData
            }
        }
    }
</script>