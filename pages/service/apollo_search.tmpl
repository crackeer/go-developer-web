<template id="template">
    <div class="well row">
        <div class="col-md-5">
            <input type="text" class="form-control" v-model="keyword" placeholder="关键词" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary" @click="doSearch" :disabled="loading">
                {{loading ? '搜索' + appID + ' / ' + namespace + '中..' : '搜索'}}
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
<table class="table table-bordered table-condensed">
                <thead>
                    <tr>
                        <th>配置key</th>
                        <th>配置值</th>
                        <th>修改</th>
                    </tr>
                <thead>
                <tbody>
                    <tr v-for="(item, i) in this.tableData">
                        <td width='10%' >{{item.app_id}}</td>
                        <td width='10%' >{{item.namespace}}</td>
                        <td width='10%' >{{item.key}}</td>
                        <td width='70%'>
                            <p>{{item.value.substring(0, 70)}}</p>
                        </td>
                        <td width='10%'>
                            <button class="btn btn-link" @click="showValue(item)">查看Value</button>
                        </td>
                    </tr>
                </tbody>
                </tbody>
            </table>
</div>
        </div>
    </div>

</template>
<script>
    window.VueObject = {
        data() {
            return {
                appIDs: [
                    "SampleApp"
                ],
                keyword: '',
                loading: false,
                appID: '',
                namespace: '',
                tableData: [],
            }
        },
        template: '#template',
        methods: {
            async doSearch() {
                if (this.keyword.length < 1) {
                    return
                }
                this.loading = true
                this.tableData = []
                console.log(this.keyword)
                let allTableData = []
                for (let i = 0; i < this.appIDs.length; i++) {
                    this.appID = this.appIDs[i]
                    let namespaces = await this.getNamespaces(this.appIDs[i])
                    for (let j = 0; j < namespaces.length; j++) {
                        this.namespace = namespaces[j]
                        let result = await this.searchTableData(this.appID, this.namespace)
                        for (let k = 0; k < result.length; k++) {
                            allTableData.push({
                                app_id: this.appID,
                                namespace: this.namespace,
                                ...result[k]
                            })
                        }
                    }
                }
                this.tableData = allTableData
                this.loading = false
            },
            async getNamespaces(appID) {
                let result = await axios.get('/api/apollo/namespace/list?app_id=' + appID)
                return result.data.data.namespace_list
            },
            async searchTableData(appID, namespace) {
                this.loading = true
                this.totalPage = 0
                this.tableData = []
                let result = await axios.get('/api/apollo/config?app_id=' + appID + '&namespace=' + namespace)
                if (result.data.code != 0) {
                    return []
                }
                if (result.data.data.config == null || result.data.data.config.length == 0  ) {
                    return []
                }
                let retData = []
                for (let i = 0; i < result.data.data.config.length; i++) {
                    let content = JSON.stringify(result.data.data.config[i])
                    if (this.keyword.length > 0 && content.indexOf(this.keyword) > -1) {
                        retData.push(result.data.data.config[i])
                    }
                }
                return retData
            },
            showValue(item) {
                showJSONString(item.value)
            }
        }
    }
</script>