<template id="template">
    <div class="row">
        <div class="col-md-3">
            <div class="panel panel-default">
                <ul class="list-group">
                    <template v-for="(item, i) in this.dataList">
                        <a class="list-group-item" href="#" @click="selectAPI(item)">{{item.name}}</a>
                    </template>
                </ul>
            </div>
        </div>
        <div class="col-md-8">
            <div class="form-horizontal">
                <div class="form-group">
                    <label for="url" class="col-sm-2 control-label">URL</label>
                    <div class="col-sm-10">
                        <input type="email" class="form-control" placeholder="url地址，例如：http://api.baidu.com/api/search"
                            v-model="url">
                    </div>
                </div>
                <div class="form-group">
                    <label for="url" class="col-sm-2 control-label">Method</label>
                    <div class="col-sm-10">
                        <label class="radio-inline">
                            <input type="radio" name="inlineRadioOptions" id="inlineRadio1" value="GET"
                                v-model="method">GET
                        </label>
                        <label class="radio-inline">
                            <input type="radio" name="inlineRadioOptions" id="inlineRadio2" value="POST"
                                v-model="method">POST
                        </label>
                        <label class="radio-inline">
                            <input type="radio" name="inlineRadioOptions" id="inlineRadio3" value="PUT"
                                v-model="method">PUT
                        </label>
                        <label class="radio-inline">
                            <input type="radio" name="inlineRadioOptions" id="inlineRadio3" value="DELETE"
                                v-model="method">DELETE
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="query" class="col-sm-2 control-label">Query参数</label>
                    <div class="col-sm-10">
                        <div id="query" style="height: 250px;"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="body" class="col-sm-2 control-label">Body参数</label>
                    <div class="col-sm-10">
                        <div id="body" style="height: 250px;"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="header" class="col-sm-2 control-label">header</label>
                    <div class="col-sm-10">
                        <div id="header" style="height: 250px;"></div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-offset-2 col-sm-10">
                        <button type="submit" class="btn btn-default" @click="doRequest">请求</button>
                    </div>
                </div>
            </div>
            <hr />
            <h3>输出</h3>
            <div id="output" style="height: 1000px;"></div>
        </div>
    </div>
</template>
<script>
    var queryJsonEditor = null
    var headerJsonEditor = null
    var outputJsonEditor = null
    var bodyJsonEditor = null
    window.VueObject = {
        data() {
            let list = []
            return {
                dataList: window.PageData,
                url: '',
                method: 'GET',
                body: {},
                query: {},
                headers: {},
            }
        },
        template: '#template',
        async mounted() {
            queryJsonEditor = initJSONEditor('query', '{}')
            headerJsonEditor = initJSONEditor('header', '{}')
            bodyJsonEditor = initJSONEditor('body', '{}')
            outputJsonEditor = initJSONEditor('output', '{}')
        },
        methods: {
            selectAPI(item) {
                if (item.method != undefined) {
                    this.method = item.method
                } else {
                    this.method = 'GET'
                }
                if (item.url != undefined) {
                    this.url = item.url
                } else {
                    this.url = ''
                }
                if (item.query != undefined) {
                    queryJsonEditor.set(item.query)
                } else {
                    queryJsonEditor.set({})
                }
                if (item.headers != undefined) {
                    headerJsonEditor.set(item.headers)
                } else {
                    headerJsonEditor.set({})
                }
                if (item.body!= undefined) {
                    bodyJsonEditor.set(item.body)
                } else {
                    bodyJsonEditor.set({})
                }
            },
            async doRequest() {
                if (this.url.length < 1 || this.method.length < 1) {
                    return
                }
                bootbox.alert('请求中...')
                outputJsonEditor.set({})
                try {
                    let result = await doHttpRequest(this.method, this.url, queryJsonEditor.get(), bodyJsonEditor.get(), headerJsonEditor.get())
                    bootbox.hideAll()
                    bootbox.alert('请求结束')
                    outputJsonEditor.set(result)
                } catch (e) {
                    bootbox.hideAll()
                    bootbox.alert(e.message)
                }
                
            },
        }
    }
</script>